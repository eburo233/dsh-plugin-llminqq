# ── 不要进版本控制的东西 ──────────────────────────────────────────────────
# 1) NapCat 的登录态 + QQ 数据（245 MB，且含账号隐私）
qqacct/data/
# 2) 运行时产物：日志、状态、pid、暂存媒体
logs/
.qq-media/
qq-agent/.qq-media/
# 3) 本地环境变量（含 WebUI token / 账号）
.env
qqacct/.env
# 4) 依赖
node_modules/
# 5) 登录二维码 / 临时图
qrcode*.png
qqacct/qrcode*.png
qr-now.png
llminqq-qr*.png
# 6) 编辑器的临时/备份文件
*.bak-*
*.tmp
*.part
.DS_Store

# ── 但 qq-agent 的「人设 / 记忆 / 性格」要进库（这些是会成长的资产）──
# qq-agent/persona/  ✅ 保留
# qq-agent/memory/   ✅ 保留（.md 见闻录 + memctl.py）
# qq-agent/meme-pack/ 的图库二进制不进，但说明留
qq-agent/meme-pack/*.db
qq-agent/meme-pack/*.jpg
qq-agent/meme-pack/*.png
qq-agent/meme-pack/*.gif
qq-agent/memory/mem.db
qq-agent/memory/log/
# 自我风格样本库（运行时数据，跟 mem.db 同性质，不进版本控制）
qq-agent/memory/style.db
qq-agent/memory/style-cases.jsonl
qq-agent/memory/.style_cursor
qq-agent/memory/.style_cursor_log
qq-agent/.bridge/

# ASR 临时音频（转写完就该清，不进库）
qq-agent/tools/tmp/

# Python 缓存
__pycache__/
*.pyc

# 桥的运行时状态目录（撤回日志等）
qq-agent/.bridge/
# B站截帧临时文件
qq-agent/.tmp-frames/
qq-agent/tools/tmp/

# 说话方式学习（运行时数据，同 mem.db/style.db 性质：会定时重新生成，不进版本控制）
# ⚠️ lexicon.json 不是代码资产，是「学出来的词库」—— 每次 learn 都会改写它，
#    进库的话每 12 小时就有一次噪音提交。模板见 qq-agent/memory/lexicon.json.example
qq-agent/memory/lexicon.json
qq-agent/memory/.lexicon-*
# 语料池的**游标**：跟 lexicon.json 同性质（每次 learn 都会改，进库就是每 12h 一次噪音提交）。
# 但 corpus/bili-*.json 本体**要进库**：那是抓取成果，重新抓要再付一次风控风险。
qq-agent/memory/corpus/.learn-cursor.json
